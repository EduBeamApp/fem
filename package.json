{
  "name": "@edubeam/fem",
  "version": "0.3.0",
  "description": "A finite element solver for plane frames and trusses, in TypeScript: Timoshenko beams, nodal and member loads, temperature, settlements, linear statics and natural frequencies.",
  "keywords": [
    "finite-element",
    "fem",
    "structural-analysis",
    "beam",
    "frame",
    "truss",
    "timoshenko",
    "statics",
    "typescript"
  ],
  "homepage": "https://www.edubeam.app/solver",
  "bugs": {
    "url": "https://github.com/EduBeamApp/fem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduBeamApp/fem.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts-fem.umd.cjs",
  "module": "./dist/ts-fem.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ts-fem.js",
      "require": "./dist/ts-fem.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/fix-dts.mjs",
    "prepare": "vite build && node scripts/fix-dts.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "publint": "publint",
    "check:types": "attw --pack --profile esm-only --ignore-rules false-esm",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run coverage && npm run build && npm run publint && npm run check:types",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Jan Vorisek",
    "email": "jan@vorisek.me",
    "url": "https://github.com/janvorisek"
  },
  "dependencies": {
    "mathjs": "^12.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.11.6",
    "@vitest/coverage-v8": "^1.6.1",
    "luqr": "^0.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "publint": "^0.3.25",
    "typescript": "^5.3.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.6.1"
  }
}
