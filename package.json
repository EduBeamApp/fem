{
  "name": "@edubeam/fem",
  "version": "0.3.0",
  "description": "A finite element solver for plane frames and trusses, in TypeScript: Timoshenko beams, nodal and member loads, temperature, settlements, linear statics and natural frequencies.",
  "keywords": [
    "finite-element",
    "fem",
    "structural-analysis",
    "beam",
    "frame",
    "truss",
    "timoshenko",
    "statics",
    "typescript"
  ],
  "homepage": "https://www.edubeam.app/solver",
  "bugs": {
    "url": "https://github.com/EduBeamApp/fem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduBeamApp/fem.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/ts-fem.umd.cjs",
  "module": "./dist/ts-fem.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ts-fem.js",
      "require": "./dist/ts-fem.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint --ext .js,.ts --ignore-path .eslintignore src",
    "dev": "vite",
    "build": "vite build && node scripts/fix-dts.mjs",
    "prepare": "vite build && node scripts/fix-dts.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "vitest run && npm run build",
    "check:types": "attw --pack --profile esm-only --ignore-rules false-esm",
    "publint": "publint"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Jan Vorisek",
    "email": "jan@vorisek.me",
    "url": "https://github.com/janvorisek"
  },
  "dependencies": {
    "mathjs": "^12.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.11.6",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "luqr": "^0.3.0",
    "prettier": "^3.2.4",
    "publint": "^0.3.25",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.2.1"
  }
}
