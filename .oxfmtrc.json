{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "tabWidth": 2,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": ["dist/", "coverage/", "node_modules/", "package-lock.json"]
}
